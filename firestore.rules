  rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'free') :
        'free';
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isPaidOrAdmin() {
      return isAuthenticated() && (getUserRole() == 'paid' || getUserRole() == 'admin');
    }

    // users collection: Users can only read/update their own profile, Admins can manage all.
    match /users/{userId} {
      allow read, update, create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // courses collection
    match /courses/{courseId} {
      // Free courses readable by all authenticated users, Premium readable only by paid users and admins.
      allow read: if isAuthenticated() && (resource.data.type == 'free' || isPaidOrAdmin());
      allow write: if isAdmin();

      // Nested lessons subcollection
      match /lessons/{lessonId} {
        // Lessons inherit access restriction of parent course (checked via parent get)
        allow read: if isAuthenticated() && (get(/databases/$(database)/documents/courses/$(courseId)).data.type == 'free' || isPaidOrAdmin());
        allow write: if isAdmin();
      }
    }

    // course_progress collection: Users can read/write their own progress, Admins can read all.
    match /course_progress/{progressId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // resources collection: Premium resources restricted to paid/admin users.
    match /resources/{resourceId} {
      allow read: if isAuthenticated() && (resource.data.accessLevel == 'free' || isPaidOrAdmin());
      allow write: if isAdmin();
    }

    // enrollments collection: Users can manage their own enrollment, Admins can read all.
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // audit_logs collection: Only admins can manage.
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // payments collection: Readable by owner or admin; writeable by admin.
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // subscriptions collection: Readable by owner or admin; writeable by admin.
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && (subscriptionId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // notifications collection: Readable, updateable, and writeable by document owner or admin.
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // course_reviews collection: Readable by authenticated users; writeable by reviewer or admin.
    match /course_reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // notes collection: Readable and writeable only by note owner or admin.
    match /notes/{noteId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // bookmarks collection: Readable and writeable only by bookmark owner or admin.
    match /bookmarks/{bookmarkId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // certificates collection: Readable globally (public lookup); writeable by admin.
    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // user_activity collection: Readable and writeable by document owner or admin.
    match /user_activity/{userId} {
      allow read, write: if isAuthenticated() && (userId == request.auth.uid || isAdmin());
    }

    // communications collection: Readable by authenticated users; writeable by admin.
    match /communications/{commId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // support_tickets collection: Users can manage their own tickets, admins manage all.
    match /support_tickets/{ticketId} {
      allow read, create, update: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ticket_messages collection: Participants or admins can read/write.
    match /ticket_messages/{messageId} {
      allow read: if isAuthenticated() && (resource.data.senderId == request.auth.uid || get(/databases/$(database)/documents/support_tickets/$(resource.data.ticketId)).data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.senderId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // posts collection (forum): Readable by authenticated users; writeable by owner or admin.
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // replies collection (forum): Readable by authenticated users; writeable by owner or admin.
    match /replies/{replyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // plans collection: Readable by authenticated users; writeable by admin.
    match /plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // settings collection: Readable by authenticated users; writeable by admin.
    match /settings/{settingsId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
